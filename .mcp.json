{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y", "chrome-devtools-mcp@1.9.0",
        "--blockedUrlPattern", "*://*/api/print/*",
        "--acceptInsecureCerts",
        "--no-usage-statistics",
        "--viewport", "1440x900",
        "--screenshotFormat", "jpeg",
        "--screenshotMaxWidth", "1400"
      ]
    }
  }
}
